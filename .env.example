# Copy to .env (next to docker-compose.yml) to override defaults. Everything is optional.

# Real email delivery (default: local Mailpit at http://localhost:8025)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=Messenger <you@gmail.com>

# Fixed master encryption key (base64, 32 bytes). Default: generated on first start and kept in the api-data volume.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MASTER_KEY=
